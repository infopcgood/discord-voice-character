DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Comma-separated server IDs. Blank or * allows every server the bot joins.
# The old DISCORD_GUILD_ID is read only when DISCORD_GUILD_IDS is absent.
DISCORD_GUILD_IDS=
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
# Optional: only these Discord user IDs may start/control the bot (comma separated).
# Blank: members in the voice channel may use it; owner/admin controls settings.
ALLOWED_USER_IDS=
# Disconnect after this many minutes without an accepted utterance.
IDLE_MINUTES=10
