DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Comma-separated server IDs. Blank or * allows every server the bot joins.
DISCORD_GUILD_IDS=

# ElevenLabs handles both recognition and synthesis. No OpenAI API key is used.
ELEVENLABS_API_KEY=
# Required: copy a Voice ID from your ElevenLabs voice library.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# Optional language hint, e.g. ko. Blank allows automatic recognition.
ELEVENLABS_STT_LANGUAGE=
# Timeout per complete synthesized sentence.
ELEVENLABS_TIMEOUT_MS=60000

# Required: your Strata OpenAI-compatible API root, including /v1 if applicable.
# Example ONLY: http://127.0.0.1:8000/v1 -- use your deployment's real address.
STRATA_BASE_URL=
# Required: exact served model ID. IDs containing / are supported.
STRATA_MODEL=
# Optional; leave blank if the local service has no authentication.
STRATA_API_KEY=
STRATA_MAX_TOKENS=128000
# Shared across guilds to avoid overloading one local GPU.
STRATA_MAX_CONCURRENT=1
# Includes waiting for a local inference slot and reading the LLM stream.
STRATA_TIMEOUT_MS=60000
# Entire response including speech synthesis.
RESPONSE_TIMEOUT_MS=180000
# Character budget (NOT tokens); includes persona and recent dialogue.
HISTORY_MAX_CHARS=24000
# Hosted transcription sessions are still time-limited. Range: 1~55.
SPEECH_SESSION_MINUTES=55

ALLOWED_USER_IDS=
IDLE_MINUTES=10

